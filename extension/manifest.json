{
  "manifest_version": 3,
  "name": "File Bookmarks",
  "version": "3.0",
  "description": "Bookmark websites and sync them to a GitHub repository",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "File Bookmarks"
  },
  "options_page": "options.html"
}
